{
  "name": "The-Clone-Wars-Project",
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,

    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared",
        "$ignoreUnknownInstances": true
      },
      "ImmaginiErrori": {
        "$path": "src/ImmaginiErrori",
        "$ignoreUnknownInstances": true
      },
      "ShipSystem": {
        "$path": "src/ShipSystem",
        "$ignoreUnknownInstances": true
      }
    },

    "ServerScriptService": {
      "$path": "src/ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "src/server",
        "$ignoreUnknownInstances": true
      }
    },

    "ServerStorage": {
      "$path": "src/ServerStorage",
      "$ignoreUnknownInstances": true
    },

    "StarterGui": {
      "$path": "src/StarterGui",
      "$ignoreUnknownInstances": true
    },

    "StarterPlayer": {
      "$path": "src/StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "src/client",
          "$ignoreUnknownInstances": true
        }
      }
    },

    "Teams": {
      "$path": "src/Teams",
      "$ignoreUnknownInstances": true
    },

    "Workspace": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      }
    },

    "Lighting": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },

    "SoundService": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
